class QueueLogHandler(logging.Handler):
    def __init__(self, q: "queue.Queue") -> None:
        super().__init__()
        self.q = q

    def emit(self, record: logging.LogRecord) -> None:
        try:
            self.q.put(("log", record.levelname, self.format(record)))
        except Exception:
            pass


def setup_logging(q: "queue.Queue") -> None:
    fmt = logging.Formatter("%(asctime)s | %(levelname)s | %(message)s", "%d.%m.%Y %H:%M:%S")
    root = logging.getLogger()
    root.setLevel(logging.INFO)
    handlers: list[logging.Handler] = [logging.FileHandler(LOG_PATH, encoding="utf-8"), QueueLogHandler(q)]
    if sys.stdout is not None:  # під pythonw / --noconsole консолі немає
        handlers.append(logging.StreamHandler(sys.stdout))
    for h in handlers:
        h.setFormatter(fmt)
        root.addHandler(h)
    logging.getLogger("telethon").setLevel(logging.WARNING)


def fmt_ts(ts: float | None) -> str:
    return time.strftime("%d.%m %H:%M:%S", time.localtime(ts)) if ts else ""


def fmt_duration(sec: float) -> str:
    sec = int(sec)
    d, rem = divmod(sec, 86400)
    h, rem = divmod(rem, 3600)
    m, s = divmod(rem, 60)
    return (f"{d} д " if d else "") + f"{h:02d}:{m:02d}:{s:02d}"



