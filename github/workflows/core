def clean_username(value: str) -> str:
    value = str(value).strip()
    value = re.sub(r"^(https?://)?(t\.me/|telegram\.me/)", "", value)
    return value.lstrip("@").strip("/ ")


def entity_ref(name: str) -> Any:
    return int(name) if re.fullmatch(r"-?\d+", name) else name


def normalize_sources(raw: Any) -> list[dict[str, Any]]:
    out: list[dict[str, Any]] = []
    seen: set[str] = set()
    for item in raw if isinstance(raw, list) else []:
        if isinstance(item, str):
            item = {"name": item}
        if not isinstance(item, dict):
            continue
        name = clean_username(item.get("name", ""))
        if not name or name.lower() in seen:
            continue
        seen.add(name.lower())
        mode = item.get("mode", "alerts")
        if mode not in MODE_LABELS:
            mode = "alerts"
        out.append({
            "name": name,
            "mode": mode,
            "enabled": bool(item.get("enabled", True)),
            "include": [str(x).strip() for x in item.get("include", []) if str(x).strip()],
            "exclude": [str(x).strip() for x in item.get("exclude", []) if str(x).strip()],
            "match": "all" if item.get("match") == "all" else "any",
            "send_mode": "forward" if item.get("send_mode") == "forward" else "copy",
            "send_media": bool(item.get("send_media", True)),
            "template": str(item.get("template", "{text}")) or "{text}",
            "dedup": bool(item.get("dedup", True)),
        })
    return out


