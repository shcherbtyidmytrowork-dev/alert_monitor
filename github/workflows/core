# ============================ ПАРСИНГ ПОВІДОМЛЕНЬ ============================
def normalize(text: str) -> str:
    return re.sub(r"[ \t]+", " ", text.casefold().replace("_", " ")).strip()


def contains_any(text: str, words: tuple[str, ...]) -> bool:
    return any(word in text for word in words)


def match_word(text: str, pattern: str) -> bool:
    """Формати: "ракет" - підрядок; "word:каб" - ціле слово; "re:ту-?\\d+" - регулярний вираз."""
    pattern = pattern.strip()
    if not pattern:
        return False
    low = pattern.casefold()
    if low.startswith("re:"):
        try:
            return re.search(pattern[3:], text, flags=re.IGNORECASE) is not None
        except re.error:
            return False
    if low.startswith("word:"):
        return re.search(r"(?<!\w)" + re.escape(low[5:]) + r"(?!\w)", text) is not None
    return low in text


def any_match(text: str, patterns: Any) -> bool:
    return any(match_word(text, w) for w in patterns or [])


def keyword_hits(text: str, words: Any, match: str = "any") -> list[str]:
    """Повертає знайдені слова. match="all": результат непорожній, лише якщо знайдено УСІ слова."""
    words = [w for w in (words or []) if str(w).strip()]
    hits = [w for w in words if match_word(text, w)]
    if match == "all" and len(hits) != len(words):
        return []
    return hits


def kw_summary(src: dict[str, Any]) -> str:
    mode = src.get("mode")
    inc = src.get("include") or []
    if mode == "alerts":
        return "глобальні тригери"
    if mode == "forward":
        return "усе"
    if not inc:
        return "стандартні" if mode == "outages" else "⚠ не задано"
    txt = ", ".join(inc[:4]) + (f" … (+{len(inc) - 4})" if len(inc) > 4 else "")
    return ("УСІ: " if src.get("match") == "all" and len(inc) > 1 else "") + txt


def detect_scope(text: str) -> str:
    text = normalize(text)
    if contains_any(text, DISTRICT_WORDS):
        return "district"
    if contains_any(text, OTHER_DISTRICT_WORDS):
        return "other"
    if contains_any(text, OBLAST_WORDS):
        return "oblast"
    return "general"


def detect_level(text: str) -> tuple[str, str] | None:
    text = normalize(text)
    for stem, emoji, label in LEVELS:
        if stem in text:
            return emoji, label
    return None


def detect_threat(text: str) -> str | None:
    text = normalize(text)
    for t in CFG["threat_types"]:
        if any_match(text, t.get("words", [])):
            return str(t.get("label", "")) or None
    return None


def trigger_matches(text: str, trig: dict[str, Any]) -> bool:
    words = trig.get("words", [])
    if not trig.get("enabled", True) or not words:
        return False
    if trig.get("match", "any") == "all":
        return all(match_word(text, w) for w in words)
    return any_match(text, words)


def parse_source_message(raw: str) -> list[dict[str, Any]]:
    text = normalize(raw)
    if not text:
        return []
    events: list[dict[str, Any]] = []
    scope = detect_scope(text)

    if any_match(text, CFG["clear_words"]) and scope != "other":
        events.append({"type": "clear", "scope": scope})

    if any_match(text, CFG["alert_words"]) and scope != "other":
        events.append({
            "type": "alert",
            "scope": scope,
            "level": detect_level(text),
            "threat": detect_threat(text),
        })

    for trig in CFG["danger_triggers"]:
        if trigger_matches(text, trig):
            events.append({"type": "danger", "trigger": trig, "raw": raw})
    return events


