def load_config() -> None:
    try:
        saved = json.loads(CONFIG_PATH.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return
    if not isinstance(saved, dict):
        return
    # міграція зі старого формату (source_channels + monitor_user)
    if "sources" not in saved and ("source_channels" in saved or "monitor_user" in saved):
        srcs = [{"name": s, "mode": "alerts", "enabled": True} for s in saved.get("source_channels", [])]
        mu = clean_username(saved.get("monitor_user", "") or "")
        if mu:
            srcs.append({"name": mu, "mode": "forward", "enabled": bool(saved.get("forward_monitor_user", True))})
        saved["sources"] = srcs
    for k, v in saved.items():
        if k in DEFAULT_CONFIG:
            CFG[k] = v
    if "danger_triggers" not in saved:  # міграція налаштувань МіГ зі старої версії
        for t in CFG["danger_triggers"]:
            if t["name"] == "Зліт МіГ":
                t["enabled"] = bool(saved.get("send_mig_takeoff", True))
                t["cooldown"] = int(saved.get("mig_cooldown_seconds", 600))
    CFG["sources"] = normalize_sources(CFG["sources"])


def save_config() -> None:
